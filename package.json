{
  "name": "git-sweep-pro",
  "displayName": "Git Sweep Pro",
  "description": "Safely prune the local Git branches whose remote branch is gone, from VS Code or the gsp command line, for you and your coding agents. Dry runs, protected branches, undo.",
  "repository": {
    "url": "git+https://github.com/MAXOUXAX/git-sweep-pro",
    "type": "git"
  },
  "homepage": "https://github.com/MAXOUXAX/git-sweep-pro#readme",
  "bugs": {
    "url": "https://github.com/MAXOUXAX/git-sweep-pro/issues"
  },
  "license": "GPL-3.0-or-later",
  "publisher": "MAXOUXAX",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "version": "1.4.0",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "branch",
    "branches",
    "prune",
    "cleanup",
    "stale branches",
    "gone upstream",
    "remote tracking",
    "delete branch",
    "scm",
    "rebase",
    "sync upstream",
    "force-with-lease",
    "housekeeping",
    "cli",
    "gsp",
    "agents",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "gsp": "./dist/cli/main.js",
    "git-sweep-pro": "./dist/cli/main.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "git-sweep-pro.run",
        "category": "Git Sweep Pro",
        "title": "Sweep Stale Branches",
        "shortTitle": "Sweep Branches"
      },
      {
        "command": "git-sweep-pro.dryRun",
        "category": "Git Sweep Pro",
        "title": "Preview Stale Branches (Dry Run)",
        "shortTitle": "Preview Sweep"
      },
      {
        "command": "git-sweep-pro.postPullRequest",
        "category": "Git Sweep Pro",
        "title": "Post Pull Request Cleanup",
        "shortTitle": "Post-PR Cleanup"
      },
      {
        "command": "git-sweep-pro.syncWithUpstream",
        "category": "Git Sweep Pro",
        "title": "Sync Branch With Upstream",
        "shortTitle": "Sync Upstream"
      },
      {
        "command": "git-sweep-pro.syncWithUpstreamResume",
        "category": "Git Sweep Pro",
        "title": "Resume Sync With Upstream",
        "shortTitle": "Resume Sync"
      },
      {
        "command": "git-sweep-pro.restore",
        "category": "Git Sweep Pro",
        "title": "Restore Deleted Branches",
        "shortTitle": "Restore Branches"
      },
      {
        "command": "git-sweep-pro.agents",
        "category": "Git Sweep Pro",
        "title": "Add Instructions for Coding Agents",
        "shortTitle": "Agent Instructions"
      }
    ],
    "configuration": {
      "title": "Git Sweep Pro",
      "properties": {
        "gitSweepPro.defaultMode": {
          "type": "string",
          "enum": [
            "dryRun",
            "safeDelete",
            "forceDelete"
          ],
          "enumDescriptions": [
            "Only report the branches that would be deleted.",
            "Delete branches with git branch -d (refuses unmerged branches).",
            "Delete branches with git branch -D (force, even if unmerged)."
          ],
          "default": "safeDelete",
          "description": "Default execution mode presented first in the Run command's mode picker."
        },
        "gitSweepPro.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns for branches that must never be deleted (e.g. `main`, `develop`, `release/*`). `*` matches any characters and `?` matches a single character."
        },
        "gitSweepPro.autoFetchPrune": {
          "type": "boolean",
          "default": true,
          "description": "Run 'git fetch -p' before detecting stale branches. Disable to operate on the local ref state only."
        },
        "gitSweepPro.confirmBeforeDelete": {
          "type": "boolean",
          "default": true,
          "description": "Show a confirmation dialog before deleting the selected branches."
        },
        "gitSweepPro.includeMergedBranches": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also offer local branches whose work is already in the remote default branch (merged, rebase-merged or squash-merged) even though their upstream is not gone — e.g. branches that were never pushed or whose remote branch was kept. They are listed but never pre-selected."
        },
        "gitSweepPro.cli.addToTerminalPath": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Make the bundled `gsp` command line (also usable as `git-sweep-pro` and `git sweep-pro`) available in VS Code's integrated terminals. New terminals pick up changes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./tsconfig.build.json --noEmit && node ./scripts/bundle.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test --label unit",
    "test:e2e": "npm run build && npm run compile && vscode-test --label e2e --label e2e-mr",
    "test:coverage": "npm run compile && vscode-test --label unit --coverage --coverage-output=coverage/unit --coverage-reporter=text-summary --coverage-reporter=json-summary --coverage-reporter=lcov",
    "test:e2e:coverage": "npm run build && npm run compile && vscode-test --label e2e --label e2e-mr --coverage --coverage-output=coverage/e2e --coverage-reporter=text-summary --coverage-reporter=json-summary --coverage-reporter=lcov",
    "coverage:check": "node ./scripts/check-coverage.mjs coverage/unit 85",
    "coverage:check:e2e": "node ./scripts/check-coverage.mjs coverage/e2e 0",
    "test:ci": "npm run test:coverage && npm run coverage:check",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "semantic-release": "semantic-release",
    "cli": "node ./out/cli/main.js"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.92.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "ovsx": "^1.2.0",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.0.5"
    }
  }
}
